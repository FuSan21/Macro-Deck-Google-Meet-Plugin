<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
	<RootNamespace>FuSan21.MacroDeck.GoogleMeet</RootNamespace>
	<UseWindowsForms>true</UseWindowsForms>
	<Version>1.0.0</Version>
	<RepositoryUrl>https://github.com/FuSan21/Macro-Deck-Google-Meet-Plugin</RepositoryUrl>
	<Authors>FuSan21</Authors>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<PackageId>Google Meet Plugin</PackageId>
	<AssemblyName>Google Meet Plugin</AssemblyName>
	<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
	<NoWarn>$(NoWarn);WFO1000</NoWarn>
	<ImplicitUsings>disable</ImplicitUsings>
	<Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SuchByte.MacroDeck" Version="2.15.0" />
  </ItemGroup>

  <!--
    The browser extension travels with the plugin, so "load unpacked" can point straight
    at the installed plugin folder and the two halves can never drift out of version.
  -->
  <ItemGroup>
    <Content Include="..\extension\**\*.*"
             Link="extension\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
